# Copy this file to .env.local and fill in your values.
#
# This app shares v-1's database — point these at the same Supabase project as v-1.
# Its tables are all prefixed `stm_` and drizzle.config.ts scopes drizzle-kit to them.
# The VGL autocomplete reads v-1's victory_group_leaders table (read-only).

# Pooled connection (used by the app at runtime)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct/unpooled connection (used by db:push / db:migrate — pooler doesn't support DDL)
# DATABASE_URL_UNPOOLED=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL_UNPOOLED=

# JWT signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Used by `npm run db:seed` to create/reset the admin account.
# SEED_ADMIN_PASSWORD defaults to "changeme" when unset — set a strong one.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
